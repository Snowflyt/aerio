{
  "extends": "./tsconfig.build.json",
  "compilerOptions": {
    "composite": true,
    "target": "ESNext",
    "lib": ["ESNext"],
    "module": "ESNext",
    "types": ["node"],
    "rootDir": "${configDir}",
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [
    "${configDir}/src/**/*",
    "${configDir}/test/**/*",
    "${configDir}/examples/**/*",
    "${configDir}/bench/**/*"
  ],
  "exclude": []
}
